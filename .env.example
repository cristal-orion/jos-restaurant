# EmailJS — invio del form "Progetta il tuo evento" (Tenuta Villa Guerra).
# Crea un account su https://www.emailjs.com, collega un servizio email e un template,
# poi copia questo file in `.env` e incolla i valori qui sotto.
#
# Nel template EmailJS usa questi campi (corrispondono ai name degli input del form):
#   {{nome}}  {{email}}  {{tipo}}  {{data}}  {{messaggio}}
# Imposta l'indirizzo destinatario ("To email") nel template stesso, non qui.
#
# Nota: sono variabili PUBLIC_ perché EmailJS lavora lato browser; la Public Key
# è pensata per essere esposta nel client (non è un segreto).

PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# Klaviyo — iscrizione del contatto alla lista "eventi" dallo stesso form.
# Company ID = Public API Key (Klaviyo → Settings → API keys). List ID = ID
# della lista (Klaviyo → Lists & Segments → apri la lista → "List ID").
# Sono opzionali: se assenti il codice usa i valori di default già presenti nel
# componente. Anche queste sono PUBLIC_ perché l'iscrizione avviene lato browser.

PUBLIC_KLAVIYO_COMPANY_ID=
PUBLIC_KLAVIYO_EVENTI_LIST_ID=

# --- Prenotazione tavolo (pagina /prenota) ---
#
# EmailJS: template dedicato alla prenotazione, così la mail che arriva in sala
# è leggibile come una prenotazione e non come una richiesta evento. Se lo lasci
# vuoto viene riusato PUBLIC_EMAILJS_TEMPLATE_ID qui sopra.
# Campi disponibili nel template (= name degli input del form):
#   {{nome}}  {{telefono}}  {{email}}  {{data}}  {{orario}}  {{ospiti}}  {{note}}  {{consenso}}

PUBLIC_EMAILJS_TEMPLATE_ID_PRENOTA=

# Klaviyo: lista a cui iscrivere chi spunta il consenso marketing nel form di
# prenotazione. NON riusare la lista eventi: sono pubblici diversi. Se lasci
# questo valore vuoto l'iscrizione viene semplicemente saltata (il form funziona
# comunque e la prenotazione viene inviata).

PUBLIC_KLAVIYO_PRENOTA_LIST_ID=

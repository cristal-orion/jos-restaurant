            <!-- Telefono: per molti clienti resta il canale naturale -->
            <div class="bg-clotted-cream border border-outline-variant/50 p-8 md:p-10 space-y-6">
              <h2 class="font-headline-md text-headline-md text-vesuvius-green leading-tight">

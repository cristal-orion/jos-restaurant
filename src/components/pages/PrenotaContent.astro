  <script>
    import emailjs from '@emailjs/browser';

    // Menu mobile (hamburger) — stesso pattern delle altre pagine
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuToggle && mobileMenu) {
      const setMenu = (open: boolean) => {
        mobileMenu.classList.toggle('hidden', !open);
        mobileMenu.classList.toggle('flex', open);
        menuToggle.textContent = open ? 'close' : 'menu';
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute(
          'aria-label',
          open ? menuToggle.dataset.labelClose! : menuToggle.dataset.labelOpen!
        );
      };
      menuToggle.addEventListener('click', () => {
        setMenu(mobileMenu.classList.contains('hidden'));
      });
      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenu(false));
      });
    }

    const form = document.getElementById('prenota-form') as HTMLFormElement | null;

    if (form) {
      const lang = form.dataset.lang === 'en' ? 'en' : 'it';
      const dateLocale = lang === 'en' ? 'en-GB' : 'it-IT';
      const dataInput = document.getElementById('pre-data') as HTMLInputElement;
      const orarioInput = document.getElementById('pre-orario') as HTMLSelectElement;
      const ospitiInput = document.getElementById('pre-ospiti') as HTMLSelectElement;
      const ospitiNota = document.getElementById('pre-ospiti-nota');
      const errorBox = document.getElementById('prenota-error');
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const submitText = submitBtn?.textContent ?? '';
      const sendingText = form.dataset.sending ?? '…';
      const placeholder = '—';

      const guestOne = form.dataset.guestOne ?? '';
      const guestMany = form.dataset.guestMany ?? '';
      const guestOver = form.dataset.guestOver ?? '';
      const closedMessage = form.dataset.closedMessage ?? '';
      const closedWeekdays = (form.dataset.closedWeekdays ?? '')
        .split(',')
        .map((d) => Number(d.trim()))
        .filter((d) => Number.isInteger(d));

      // Data locale in formato YYYY-MM-DD, senza passare da toISOString()
      // (che converte in UTC e di sera sposta il giorno indietro).
      const pad = (n: number) => String(n).padStart(2, '0');
      const toLocalISO = (d: Date) =>
        `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
      // La stringa del campo date va letta come data locale: senza l'orario
      // esplicito il browser la interpreta come UTC.
      const parseLocalDate = (value: string) => new Date(`${value}T00:00:00`);

      // Non si prenota nel passato
      dataInput.min = toLocalISO(new Date());

      const setCustomError = (message: string) => {
        dataInput.setCustomValidity(message);
        if (message) dataInput.reportValidity();
      };

      const isClosed = (value: string) => {
        if (!value || closedWeekdays.length === 0) return false;
        return closedWeekdays.includes(parseLocalDate(value).getDay());
      };

      // Riepilogo live nella colonna di destra
      const recap = {
        data: document.getElementById('recap-data'),
        orario: document.getElementById('recap-orario'),
        ospiti: document.getElementById('recap-ospiti'),
      };

      const renderRecap = () => {
        if (recap.data) {
          const value = dataInput.value;
          recap.data.textContent = value
            ? parseLocalDate(value).toLocaleDateString(dateLocale, {
                weekday: 'long',
                day: 'numeric',
                month: 'long',
              })
            : placeholder;
        }
        if (recap.orario) {
          recap.orario.textContent = orarioInput.value || placeholder;
        }
        if (recap.ospiti) {
          const value = ospitiInput.value;
          if (!value) {
            recap.ospiti.textContent = placeholder;
          } else if (value === 'oltre') {
            recap.ospiti.textContent = guestOver;
          } else {
            recap.ospiti.textContent = `${value} ${value === '1' ? guestOne : guestMany}`;
          }
        }
      };

      dataInput.addEventListener('change', () => {
        setCustomError(isClosed(dataInput.value) ? closedMessage : '');
        renderRecap();
      });
      orarioInput.addEventListener('change', renderRecap);
      ospitiInput.addEventListener('change', () => {
        ospitiNota?.classList.toggle('hidden', ospitiInput.value !== 'oltre');
        renderRecap();
      });

      // Il browser può ripristinare i valori al ricaricamento della pagina
      renderRecap();
      ospitiNota?.classList.toggle('hidden', ospitiInput.value !== 'oltre');

      // Iscrizione facoltativa alla lista prenotazioni di Klaviyo: solo se
      // l'utente ha spuntato il consenso E la lista è configurata.
      // Best-effort — un errore qui non deve fermare la prenotazione.
      const subscribeToKlaviyo = async () => {
        const companyId = form.dataset.klaviyoCompanyId;
        const listId = form.dataset.klaviyoListId;
        const consenso = form.querySelector<HTMLInputElement>('#pre-consenso')?.checked;
        if (!companyId || !listId || !consenso) return;

        const formData = new FormData(form);
        const email = String(formData.get('email') ?? '').trim();
        if (!email) return;

        const fullName = String(formData.get('nome') ?? '').trim();
        const [firstName, ...lastNameParts] = fullName.split(/\s+/).filter(Boolean);

        await fetch(
          `https://a.klaviyo.com/client/subscriptions/?company_id=${encodeURIComponent(companyId)}`,
          {
            method: 'POST',
            headers: {
              accept: 'application/json',
              'content-type': 'application/json',
              revision: '2025-01-15',
            },
            body: JSON.stringify({
              data: {
                type: 'subscription',
                attributes: {
                  custom_source: 'Josè Restaurant - prenotazione tavolo',
                  profile: {
                    data: {
                      type: 'profile',
                      attributes: {
                        email,
                        ...(firstName ? { first_name: firstName } : {}),
                        ...(lastNameParts.length
                          ? { last_name: lastNameParts.join(' ') }
                          : {}),
                        ...(formData.get('telefono')
                          ? { properties: { telefono: formData.get('telefono') } }
                          : {}),
                        subscriptions: {
                          email: { marketing: { consent: 'SUBSCRIBED' } },
                        },
                      },
                    },
                  },
                },
                relationships: { list: { data: { type: 'list', id: listId } } },
              },
            }),
          }
        );
      };

      // Invio: EmailJS manda la richiesta in sala, poi si va alla pagina di
      // ringraziamento. Template dedicato alle prenotazioni se configurato,
      // altrimenti si riusa quello generico (vedi .env.example).
      const serviceId = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID;
      const templateId =
        import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID_PRENOTA ||
        import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID;
      const publicKey = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY;
      const isConfigured = Boolean(serviceId && templateId && publicKey);
      const redirect = form.dataset.redirect;

      const goToThanks = () => {
        if (redirect) window.location.href = redirect;
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // novalidate sul form: la validazione la chiediamo noi, così il
        // messaggio sulla data di chiusura convive con i required nativi.
        setCustomError(isClosed(dataInput.value) ? closedMessage : '');
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        errorBox?.classList.add('hidden');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = sendingText;
        }

        try {
          await subscribeToKlaviyo();
        } catch (error) {
          console.error('Errore iscrizione Klaviyo', error);
        }

        if (!isConfigured) {
          console.warn(
            'EmailJS non configurato: imposta PUBLIC_EMAILJS_SERVICE_ID, PUBLIC_EMAILJS_TEMPLATE_ID(_PRENOTA) e PUBLIC_EMAILJS_PUBLIC_KEY in .env. Redirect alla pagina di ringraziamento senza invio.'
          );
          goToThanks();
          return;
        }

        try {
          await emailjs.sendForm(serviceId, templateId, form, { publicKey });
          goToThanks();
        } catch (err) {
          console.error('Invio EmailJS fallito:', err);
          errorBox?.classList.remove('hidden');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = submitText;
          }
        }
      });
    }
  </script>
</Base>

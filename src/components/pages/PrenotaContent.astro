                  class="group inline-flex items-center gap-2 font-label-sm text-label-sm uppercase tracking-widest text-vesuvius-green hover:text-terracotta transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-vesuvius-green"
                >
